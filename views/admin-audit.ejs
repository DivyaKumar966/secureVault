<%- include('partials/header') %><div class="admin-layout"><%- include('partials/admin-nav') %><main class="admin-main"><div class="admin-page-head"><div><span class="page-kicker">SECURITY & COMPLIANCE</span><h1>Audit Center</h1><p>Trace important user and administrator activity from one place.</p></div></div><div class="admin-overview-grid"><section class="admin-section"><div class="admin-section-head"><div><h2>User Activity</h2><small>Latest 250 events</small></div></div><div class="table-responsive admin-table-wrap"><table class="table admin-table"><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Details</th><th>IP</th></tr></thead><tbody><% userAudit.forEach(a=>{ %><tr><td><%= new Date(a.created_at).toLocaleString() %></td><td><%= a.email %></td><td><span class="admin-action-badge"><%= a.action %></span></td><td><%= a.details||'—' %></td><td><%= a.ip_address||'—' %></td></tr><% }) %><% if(!userAudit.length){ %><tr><td colspan="5" class="text-center">No user audit activity.</td></tr><% } %></tbody></table></div></section><section class="admin-section"><div class="admin-section-head"><div><h2>Administrator Activity</h2><small>Latest 250 events</small></div></div><div class="table-responsive admin-table-wrap"><table class="table admin-table"><thead><tr><th>Time</th><th>Admin</th><th>Action</th><th>Details</th><th>IP</th></tr></thead><tbody><% adminAudit.forEach(a=>{ %><tr><td><%= new Date(a.created_at).toLocaleString() %></td><td><%= a.admin_email %></td><td><span class="admin-action-badge"><%= a.action %></span></td><td><%= a.details||'—' %></td><td><%= a.ip_address||'—' %></td></tr><% }) %><% if(!adminAudit.length){ %><tr><td colspan="5" class="text-center">No administrator activity.</td></tr><% } %></tbody></table></div></section></div></main></div><%- include('partials/footer') %>
