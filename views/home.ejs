<%- include('partials/header') %>

<main class="landing-page">
  <section class="landing-hero">
    <div class="container">
      <div class="landing-hero-inner">
        <div class="landing-copy">
          <span class="hero-badge">🔐 PRIVACY-FIRST DIGITAL VAULT</span>
          <h1>Secure your files.<br><span>Own your privacy.</span></h1>
          <p class="hero-description">
            Store, organize, share and protect your important digital files from one secure place.
            Built for privacy, control and everyday convenience.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary btn-lg landing-primary" href="/register">GET STARTED</a>
            <a class="btn btn-outline-dark btn-lg landing-secondary" href="/login">LOGIN</a>
          </div>

          <div class="hero-trust-row">
            <span>✓ Private storage</span>
            <span>✓ Secure sharing</span>
            <span>✓ Controlled sharing</span>
          </div>
        </div>

        <div class="landing-visual">
          <div class="vault-orbit orbit-one"></div>
          <div class="vault-orbit orbit-two"></div>
          <div class="vault-glow"></div>
          <div class="vault-logo-card">
            <img src="/images/logo.png" alt="Secure Vault Logo" class="landing-logo">
            <div class="vault-logo-title">SECURE VAULT</div>
            <div class="vault-logo-subtitle">Your files. Your privacy. Your vault.</div>
            <div class="vault-status"><span></span> Vault protection active</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-features">
    <div class="container">
      <div class="section-heading">
        <span>BUILT FOR CONTROL</span>
        <h2>Everything important, protected in one vault.</h2>
        <p>Secure file storage and controlled sharing without unnecessary complexity.</p>
      </div>

      <div class="landing-feature-grid">
        <div class="landing-feature-card">
          <div class="feature-icon">🗂️</div>
          <h3>Organize</h3>
          <p>Keep photos, videos, documents and text files neatly separated and easy to access.</p>
        </div>
        <div class="landing-feature-card">
          <div class="feature-icon">🔗</div>
          <h3>Share Safely</h3>
          <p>Create controlled links with passwords, expiry dates and download limits.</p>
        </div>
        <div class="landing-feature-card">
          <div class="feature-icon">🛡️</div>
          <h3>Controlled Access</h3>
          <p>Protect a shared file with a password, expiry date and download/access limit.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-cta">
    <div class="container">
      <div class="landing-cta-card">
        <div>
          <span class="hero-badge">READY WHEN YOU ARE</span>
          <h2>Take control of your digital files.</h2>
          <p>Start building your private space with Secure Vault.</p>
        </div>
        <a href="/register" class="btn btn-light btn-lg">CREATE YOUR VAULT</a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
