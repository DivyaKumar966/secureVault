<%- include("partials/header") %>

<div class="container py-5">

    <!-- ================= PAGE HEADER ================= -->

    <div class="text-center mb-5">

        <h1 class="display-5 fw-bold text-primary">
            <%= type.toUpperCase() %> FILES
        </h1>

        <p class="text-muted">
            Securely upload and manage your <%= type %> files.
        </p>

    </div>


    <!-- ================= UPLOAD BOX ================= -->

    <div class="upload-box shadow p-4 rounded">

        <form
            action="/upload"
            method="POST"
            enctype="multipart/form-data">

            <!-- Current Page Type -->

            <input
                type="hidden"
                name="type"
                value="<%= type %>">


            <!-- File Input -->

            <input
                type="file"
                name="file"
                id="fileInput"
                hidden

                <% if(type === "image"){ %>
                    accept="image/*"
                <% } %>

                <% if(type === "video"){ %>
                    accept="video/*"
                <% } %>

                <% if(type === "document"){ %>
                    accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx"
                <% } %>

                <% if(type === "text"){ %>
                    accept=".txt,.json,.csv,.xml"
                <% } %>
            >


            <!-- Choose Button -->

            <button
                type="button"
                class="btn btn-outline-primary"
                id="chooseBtn">

                + Choose File

            </button>


            <!-- Upload Button -->

            <button
                type="submit"
                class="btn btn-outline-success">

                ⬆ Upload

            </button>


        </form>


        <!-- Selected File -->

        <p
            id="fileName"
            class="mt-3 fw-bold text-secondary">
        </p>

    </div>


    <hr class="my-5">


    <!-- ================= FILE GRID ================= -->

    <div class="rowofFile">

        <% if(files.length > 0){ %>

            <% files.forEach(file => { %>

                <div class="col-lg-4 col-md-6 mb-4 boxofFile">

                    <div class="card file-card h-100 shadow-sm">


                        <!-- ================= PREVIEW ================= -->

                        <% if(type === "image"){ %>

                            <img
                                src="<%= file.file_url %>"
                                class="card-img-top preview-image"
                                alt="<%= file.file_name %>">

                        <% } else if(type === "video"){ %>

                            <video
                                class="card-img-top preview-image"
                                controls>

                                <source
                                    src="<%= file.file_url %>">

                                Your browser does not support video playback.

                            </video>

                        <% } else if(type === "document"){ %>

                            <div class="text-center py-5">

                                <h1>📄</h1>

                            </div>

                        <% } else { %>

                            <div class="text-center py-5">

                                <h1>📝</h1>

                            </div>

                        <% } %>


                        <!-- ================= FILE DETAILS ================= -->

                        <div class="fileCard-body">

                            <h5
                                class="card-title"
                                title="<%= file.file_name %>">

                                <%= file.file_name %>

                            </h5>


                            <span class="badge bg-primary">

                                <%= file.file_type %>

                            </span>


                            <p class="mt-3 mb-0">

                                <strong>Size :</strong>

                                <%= (file.file_size / 1024).toFixed(2) %> KB

                            </p>

                        </div>


                        <!-- ================= ACTIONS ================= -->

                        <div class="card-footer bg-white border-0">


                            <!-- VIEW -->

                            <a
                                href="<%= file.file_url %>"
                                target="_blank"
                                class="btn btn-outline-primary w-100 mb-2">

                                👁 View

                            </a>


                            <!-- DOWNLOAD -->

                            <a
                                href="/download/<%= file.id %>"
                                class="btn btn-outline-success w-100 mb-2">

                                ⬇ Download

                            </a>


                            <!-- DELETE -->

                            <a
                                href="/sharing?fileId=<%= file.id %>"
                                class="btn btn-outline-dark w-100 mb-2">

                                🔗 Secure Share

                            </a>

                            <button
                                type="button"
                                class="btn btn-danger w-100 deleteBtn"

                                data-id="<%= file.id %>"

                                data-name="<%= file.file_name %>">

                                🗑 Delete

                            </button>

                        </div>

                    </div>

                </div>

            <% }) %>


        <% } else { %>


            <!-- ================= EMPTY STATE ================= -->

            <div class="empty-file-state">
                <div class="empty-file-icon">
                    <% if(type === "image"){ %>🖼️
                    <% } else if(type === "video"){ %>🎥
                    <% } else if(type === "document"){ %>📄
                    <% } else { %>📝<% } %>
                </div>
                <h3>No Files Uploaded</h3>
                <p class="text-muted">Upload your first <%= type %> file to your Secure Vault.</p>
            </div>


        <% } %>

    </div>

</div>



<!-- =====================================================
     DELETE CONFIRMATION MODAL
===================================================== -->

<div
    class="modal fade"
    id="deleteModal"
    tabindex="-1"
    aria-labelledby="deleteModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <!-- Modal Header -->

            <div class="modal-header">

                <h5
                    class="modal-title"
                    id="deleteModalLabel">

                    🗑 Delete File

                </h5>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">

                </button>

            </div>


            <!-- Modal Body -->

            <div class="modal-body">

                <p id="deleteText"></p>

                <div class="alert alert-danger mb-0">

                    ⚠️ This action cannot be undone.

                </div>

            </div>


            <!-- Modal Footer -->

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    Cancel

                </button>


                <form
                    id="deleteForm"
                    method="POST">

                    <button
                        type="submit"
                        class="btn btn-danger">

                        🗑 Delete

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>



<%- include("partials/footer") %>



<script>

/* =====================================================
   FILE SELECTION
===================================================== */

const chooseBtn =
    document.getElementById("chooseBtn");

const fileInput =
    document.getElementById("fileInput");

const fileName =
    document.getElementById("fileName");


chooseBtn.addEventListener("click", () => {

    fileInput.click();

});


fileInput.addEventListener("change", () => {

    if(fileInput.files.length > 0){

        const selectedFile =
            fileInput.files[0];

        fileName.innerHTML =
            "✅ Selected : " +
            selectedFile.name;

    } else {

        fileName.innerHTML = "";

    }

});



/* =====================================================
   BOOTSTRAP DELETE MODAL
===================================================== */

const deleteModalElement =
    document.getElementById("deleteModal");


const deleteModal =
    new bootstrap.Modal(deleteModalElement);


const deleteButtons =
    document.querySelectorAll(".deleteBtn");


const deleteForm =
    document.getElementById("deleteForm");


const deleteText =
    document.getElementById("deleteText");


deleteButtons.forEach(button => {

    button.addEventListener("click", () => {

        const id =
            button.dataset.id;

        const name =
            button.dataset.name;


        /* File name inside modal */

        deleteText.innerHTML =
            `Are you sure you want to delete <strong>${name}</strong>?`;


        /* Dynamic delete route */

        deleteForm.action =
            "/delete/" + id;


        /* Show modal */

        deleteModal.show();

    });

});

</script>
```
