<%- include('partials/header') %>

  <div class="jumbotron text-center">
    <div class="container">

      <img src="/images/logo.png" alt="Secure Vault Logo" class="logo">

      <h1 class="slogan mt-4">
        Your Files. Your Privacy. Your Vault.
      </h1>

      <p class="lead">
        Securely store, organize, and access your photos, videos,
        documents, and text files anytime, anywhere.
      </p>

      <hr>


      <div class="btn-group mt-4 mb-4" role="group">

        <a href="/files/image" class="btn btn-outline-primary">
          📷 Photos
        </a>

        <a href="/files/video" class="btn btn-outline-primary">
          🎥 Videos
        </a>

        <a href="/files/document" class="btn btn-outline-primary">
          📄 Documents
        </a>

        <a href="/files/text" class="btn btn-outline-primary">
          📝 Text Files
        </a>

      </div>
      <div class="vault-stats-row">
        <div class="vault-mini-stat"><strong><%= stats.total %></strong><span>Total Files</span></div>
        <div class="vault-mini-stat"><strong><%= stats.images %></strong><span>Images</span></div>
        <div class="vault-mini-stat"><strong><%= stats.videos %></strong><span>Videos</span></div>
        <div class="vault-mini-stat"><strong><%= stats.documents %></strong><span>Documents</span></div>
      </div>

      <a href="/sharing" class="btn btn-primary btn-lg tools-main-btn mt-3 mb-3">🔗 Secure File Sharing</a>

      <br>

      <form action="/logout" method="get">
        <button type="submit" class="btn btn-outline-danger">
          LOGOUT
        </button>
      </form>
    </div>
  </div>

  <%- include('partials/footer') %>