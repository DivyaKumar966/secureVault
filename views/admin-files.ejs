<%- include('partials/header') %><div class="admin-layout"><%- include('partials/admin-nav') %><main class="admin-main"><div class="admin-page-head"><div><span class="page-kicker">STORAGE MANAGEMENT</span><h1>Files</h1><p>Monitor every file stored in the Secure Vault platform.</p></div></div><section class="admin-section admin-full-section"><div class="admin-section-head"><div><h2>All Stored Files</h2></div><span class="admin-pill"><%= files.length %> files</span></div><div class="table-responsive admin-table-wrap"><table class="table admin-table"><thead><tr><th>File</th><th>Owner</th><th>Type</th><th>Size</th><th>Uploaded</th></tr></thead><tbody><% files.forEach(f=>{ %><tr><td><strong class="admin-file-name"><%= f.file_name %></strong></td><td><%= f.email %></td><td><span class="admin-type"><%= f.file_type %></span></td><td><%= (Number(f.file_size||0)/1024/1024).toFixed(2) %> MB</td><td><%= new Date(f.uploaded_at).toLocaleString() %></td></tr><% }) %><% if(!files.length){ %><tr><td colspan="5" class="text-center">No files found.</td></tr><% } %></tbody></table></div></section></main></div><%- include('partials/footer') %>
