<%- include('partials/header') %><div class="admin-layout"><%- include('partials/admin-nav') %><main class="admin-main"><div class="admin-page-head"><div><span class="page-kicker">ACCOUNT MANAGEMENT</span><h1>Users</h1><p>Review registered accounts and their storage footprint.</p></div></div><section class="admin-section admin-full-section"><div class="admin-section-head"><div><h2>All Registered Users</h2></div><span class="admin-pill"><%= users.length %> users</span></div><div class="table-responsive admin-table-wrap"><table class="table admin-table"><thead><tr><th>#</th><th>Email</th><th>Joined</th><th>Files</th><th>Storage</th></tr></thead><tbody><% users.forEach((u,i)=>{ %><tr><td><%= i+1 %></td><td><strong><%= u.email %></strong></td><td><%= new Date(u.created_at).toLocaleString() %></td><td><span class="admin-count"><%= u.file_count %></span></td><td><%= (Number(u.storage_bytes||0)/1024/1024).toFixed(2) %> MB</td></tr><% }) %><% if(!users.length){ %><tr><td colspan="5" class="text-center">No users found.</td></tr><% } %></tbody></table></div></section></main></div><%- include('partials/footer') %>
