<%- include('partials/header') %>
<div class="admin-layout"><%- include('partials/admin-nav') %><main class="admin-main"><div class="admin-mobile-title"><span>SECURE VAULT ADMIN</span><strong>Control Center</strong></div>
  <div class="admin-page-head"><div><span class="page-kicker">PLATFORM OVERVIEW</span><h1>Admin Control Center</h1><p>Monitor the health, activity and security of your Secure Vault platform.</p></div><span class="admin-user-pill">👤 <%= adminEmail %></span></div>
  <div class="admin-stat-grid">
    <a class="admin-stat" href="/admin/users"><span>👥 Total Users</span><strong><%= stats.users %></strong><small>Registered accounts →</small></a>
    <a class="admin-stat" href="/admin/files"><span>📁 Total Files</span><strong><%= stats.files %></strong><small>Stored media →</small></a>
    <a class="admin-stat" href="/admin/files"><span>☁️ Storage Used</span><strong><%= (Number(stats.storage_bytes || 0) / 1024 / 1024).toFixed(1) %> MB</strong><small>Across all users →</small></a>
    <a class="admin-stat" href="/admin/shares"><span>🔗 Active Shares</span><strong><%= stats.active_shares %></strong><small>Manage links →</small></a>
  </div>
  <div class="admin-overview-grid">
    <section class="admin-section"><div class="admin-section-head"><div><span class="panel-kicker">ACCOUNT ACTIVITY</span><h2>Recent Users</h2></div><a href="/admin/users">View all →</a></div><div class="table-responsive admin-table-wrap"><table class="table admin-table"><thead><tr><th>User</th><th>Joined</th><th>Files</th></tr></thead><tbody><% recentUsers.forEach(user => { %><tr><td><strong><%= user.email %></strong></td><td><%= new Date(user.created_at).toLocaleString() %></td><td><span class="admin-count"><%= user.file_count %></span></td></tr><% }) %><% if (!recentUsers.length) { %><tr><td colspan="3" class="text-center">No users found.</td></tr><% } %></tbody></table></div></section>
    <section class="admin-section"><div class="admin-section-head"><div><span class="panel-kicker">STORAGE ACTIVITY</span><h2>Recent Files</h2></div><a href="/admin/files">View all →</a></div><div class="table-responsive admin-table-wrap"><table class="table admin-table"><thead><tr><th>File</th><th>Owner</th><th>Type</th></tr></thead><tbody><% recentFiles.forEach(file => { %><tr><td><strong class="admin-file-name"><%= file.file_name %></strong></td><td><%= file.email %></td><td><span class="admin-type"><%= file.file_type %></span></td></tr><% }) %><% if (!recentFiles.length) { %><tr><td colspan="3" class="text-center">No files found.</td></tr><% } %></tbody></table></div></section>
  </div>
  <div class="admin-overview-grid">
    <section class="admin-section"><div class="admin-section-head"><div><span class="panel-kicker">SHARING</span><h2>Secure Shares</h2></div><a href="/admin/shares">Manage →</a></div><div class="table-responsive admin-table-wrap"><table class="table admin-table"><thead><tr><th>File</th><th>Status</th><th>Downloads</th></tr></thead><tbody><% recentShares.forEach(share => { const expired=share.expires_at && new Date(share.expires_at)<=new Date(); %><tr><td><strong><%= share.file_name %></strong></td><td><span class="status-chip <%= share.revoked?'status-off':expired?'status-warn':'status-on' %>"><%= share.revoked?'Revoked':expired?'Expired':'Active' %></span></td><td><%= share.download_count %><%= share.max_downloads===null?'':' / '+share.max_downloads %></td></tr><% }) %></tbody></table></div></section>
    <section class="admin-section"><div class="admin-section-head"><div><span class="panel-kicker">SECURITY</span><h2>Recent Audit Activity</h2></div><a href="/admin/audit">Open center →</a></div><div class="admin-timeline"><% recentAudit.forEach(log => { %><div class="admin-timeline-item"><span></span><div><strong><%= log.action %></strong><p><%= log.email %> · <%= log.details || 'Security event recorded' %></p><small><%= new Date(log.created_at).toLocaleString() %></small></div></div><% }) %><% if (!recentAudit.length) { %><p class="empty-state">No audit activity yet.</p><% } %></div></section>
  </div>
</main></div><%- include('partials/footer') %>
